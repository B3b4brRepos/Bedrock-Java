  "id": "originalsword",
  "version": "${version}",
  "name": "OriginalSword",
  "description": "First-person sword animations (draw, 4-hit combo, inspect) ported from the Bedrock OriginalSword pack.",
  "authors": ["Kyy x Tacz (original Bedrock pack)"],
  "license": "MIT (code); original authors (assets)",
  "icon": "assets/originalsword/icon.png",
